---
// Схема нервов руки или ноги: ход нервов, места сдавления и зоны чувствительности.
// focus — какой синдром подсветить; без focus показываются все нервы.
type Focus = 'carpal' | 'cubital' | 'guyon' | 'meralgia' | 'peroneal' | 'tarsal' | undefined;
interface Props { limb: 'arm' | 'leg'; focus?: Focus; lang?: 'ru' | 'en' }
const { limb, focus, lang = 'ru' } = Astro.props;
const en = lang === 'en';

const nerveOf: Record<string, string> = { carpal: 'median', cubital: 'ulnar', guyon: 'ulnar', meralgia: 'lfcn', peroneal: 'peroneal', tarsal: 'tibial' };
const hot = focus ? nerveOf[focus] : undefined;
const cls = (n: string) => `nv nv-${n}${hot && hot !== n ? ' dim' : ''}`;
const zcls = (n: string, on = true) => `nz nz-${n}${hot && (hot !== n || !on) ? ' dim' : ''}`;
const showSite = (s: string) => !focus || focus === s;

// Палец или другой «столбик»: прямоугольник со скруглёнными концами между двумя точками.
const cap = (x1: number, y1: number, x2: number, y2: number, w: number) => {
  const len = Math.hypot(x2 - x1, y2 - y1);
  const ang = (Math.atan2(y2 - y1, x2 - x1) * 180) / Math.PI;
  return { x: x1 - w / 2, y: y1 - w / 2, width: len + w, height: w, rx: w / 2, transform: `rotate(${ang.toFixed(1)} ${x1} ${y1})` };
};

// Кисть для схемы зон (пальцы вверх, большой палец слева).
const handCaps = [cap(65, 165, 57, 58, 25), cap(91, 160, 91, 38, 26), cap(117, 162, 123, 54, 25), cap(140, 172, 153, 92, 22), cap(58, 238, 17, 152, 30)];
// Кисть на схеме руки (пальцы вниз).
const handT = 'translate(201 352) rotate(180) scale(.66) translate(-102 -262)';
const armPath = 'M152 20 C150 60 150 100 152 132 C146 144 147 158 153 170 C150 215 160 290 172 352 L230 352 C240 290 254 220 249 176 C251 160 250 146 247 132 C252 100 252 60 248 20 Z';
const legPath = 'M118 20 C108 90 130 190 156 262 C150 290 148 320 154 350 C160 400 172 430 178 456 C170 470 158 492 158 508 C158 522 176 527 198 527 C222 527 240 521 238 506 C236 490 225 470 219 456 C226 420 240 370 238 330 C238 300 234 280 232 262 C244 200 262 120 266 60 L266 20 Z';
const solePath = 'M312 470 C308 500 322 512 336 512 C352 512 362 498 358 470 C354 440 366 410 364 380 C362 350 350 338 332 340 C312 342 300 360 302 390 C304 420 316 440 312 470 Z';
const toes = [[352, 321, 12], [334, 316, 8], [320, 320, 7], [308, 328, 6.5], [299, 339, 6]];

const t = en
  ? {
      median: 'Median nerve', ulnar: 'Ulnar nerve', radial: 'Radial nerve',
      cubital: 'Cubital tunnel', cubital2: 'at the elbow', carpal: 'Carpal tunnel', carpal2: 'at the wrist', guyon: 'Guyon canal', guyon2: 'at the wrist',
      palm: 'Palm', back: 'Back of the hand',
      lfcn: 'Cutaneous nerve', lfcn2: 'of the thigh', sciatic: 'Sciatic', peroneal: 'Peroneal', tibial: 'Tibial', nerve: 'nerve',
      inguinal: 'Inguinal', inguinal2: 'ligament', fibhead: 'Just below', fibhead2: 'the knee', tarsal: 'Tarsal tunnel,', tarsal2: 'inner ankle',
      front: 'Front view', sole: 'Sole', behind: 'dashed line — the nerve runs at the back',
    }
  : {
      median: 'Срединный нерв', ulnar: 'Локтевой нерв', radial: 'Лучевой нерв',
      cubital: 'Кубитальный', cubital2: 'канал, локоть', carpal: 'Запястный', carpal2: 'канал', guyon: 'Канал', guyon2: 'Гийона',
      palm: 'Ладонь', back: 'Тыл кисти',
      lfcn: 'Кожный нерв', lfcn2: 'бедра', sciatic: 'Седалищный', peroneal: 'Малоберцовый', tibial: 'Большеберцовый', nerve: 'нерв',
      inguinal: 'Паховая', inguinal2: 'связка', fibhead: 'Чуть ниже', fibhead2: 'колена', tarsal: 'Тарзальный канал,', tarsal2: 'лодыжка',
      front: 'Вид спереди', sole: 'Подошва', behind: 'пунктир — нерв идёт по задней поверхности',
    };

const legend: [string, string, string][] = limb === 'arm'
  ? en
    ? [
        ['median', 'Median nerve', 'is compressed in the carpal tunnel at the wrist. Feeling in the thumb, index, middle and half of the ring finger on the palm side.'],
        ['ulnar', 'Ulnar nerve', 'is compressed at the elbow (cubital tunnel) or at the wrist (Guyon canal). Feeling in the little finger and half of the ring finger.'],
        ['radial', 'Radial nerve', 'is affected less often, usually in the upper arm. Feeling on the back of the hand on the thumb side.'],
      ]
    : [
        ['median', 'Срединный нерв', 'сдавливается в запястном канале. Чувствительность большого, указательного, среднего и половины безымянного пальца со стороны ладони.'],
        ['ulnar', 'Локтевой нерв', 'сдавливается у локтя (кубитальный канал) или на запястье (канал Гийона). Чувствительность мизинца и половины безымянного пальца.'],
        ['radial', 'Лучевой нерв', 'страдает реже, обычно на уровне плеча. Чувствительность тыла кисти со стороны большого пальца.'],
      ]
  : en
    ? [
        ['lfcn', 'Lateral femoral cutaneous nerve', 'is compressed under the inguinal ligament (meralgia). Feeling on the outer side of the thigh.'],
        ['peroneal', 'Peroneal nerve', 'is compressed at the fibular head, just below the knee. Feeling on the outer side of the shin and the top of the foot; lifts the foot.'],
        ['tibial', 'Tibial nerve', 'is compressed behind the inner ankle (tarsal tunnel). Feeling in the sole.'],
      ]
    : [
        ['lfcn', 'Наружный кожный нерв бедра', 'сдавливается под паховой связкой (мералгия). Чувствительность наружной поверхности бедра.'],
        ['peroneal', 'Малоберцовый нерв', 'сдавливается у головки малоберцовой кости, чуть ниже колена. Чувствительность наружной поверхности голени и тыла стопы; поднимает стопу.'],
        ['tibial', 'Большеберцовый нерв', 'сдавливается за внутренней лодыжкой (тарзальный канал). Чувствительность подошвы.'],
      ];

const aria = limb === 'arm'
  ? (en ? 'Nerves of the arm: where they are compressed and which areas of the hand they supply' : 'Нервы руки: где они сдавливаются и за какие зоны кисти отвечают')
  : (en ? 'Nerves of the leg: where they are compressed and which areas they supply' : 'Нервы ноги: где они сдавливаются и за какие зоны отвечают');
const caption = en
  ? 'Simplified diagram. The borders of the areas differ a little from person to person.'
  : 'Упрощённая схема. Границы зон у разных людей немного различаются.';
---
<figure class="scheme nerve-fig">
  <div class="scheme-pair">
    {limb === 'arm' && (
      <svg viewBox="0 0 400 540" role="img" aria-label={aria} xmlns="http://www.w3.org/2000/svg">
        <g class="skin-edge"><path d={armPath} /><g transform={handT}><rect x="45" y="150" width="112" height="125" rx="24" />{handCaps.map((c) => <rect {...c} />)}</g></g>
        <g class="skin"><path d={armPath} /><g transform={handT}><rect x="45" y="150" width="112" height="125" rx="24" />{handCaps.map((c) => <rect {...c} />)}</g></g>
        <path class="crease" d="M158 158 Q200 172 244 156" /><path class="crease" d="M176 352 Q201 359 227 352" />

        <path class={`${cls('radial')} back`} d="M214 20 C222 50 234 80 240 104" />
        <path class={cls('radial')} d="M240 104 C244 130 238 148 234 164 C238 230 232 300 226 346 L238 374" />
        <path class={cls('ulnar')} d="M164 20 C160 70 154 110 154 150 C158 200 172 290 184 352" />
        <path class={cls('median')} d="M176 20 C176 70 188 110 198 152 C202 210 202 300 202 352" />
        <g transform={handT}>
          <path class={`${cls('ulnar')} thin`} d="M129 262 L128 240 M128 240 L150 106 M128 240 L125 74" />
          <path class={`${cls('median')} thin`} d="M101 262 L100 240 M100 240 L28 168 M100 240 L59 74 M100 240 L91 56 M100 240 L117 74" />
        </g>

        {showSite('cubital') && <g class="site"><circle cx="154" cy="150" r="13" class="glow" /><circle cx="154" cy="150" r="5" class="core" /></g>}
        {showSite('carpal') && <g class="site"><circle cx="202" cy="362" r="12" class="glow" /><circle cx="202" cy="362" r="5" class="core" /></g>}
        {showSite('guyon') && <g class="site"><circle cx="183" cy="364" r="12" class="glow" /><circle cx="183" cy="364" r="5" class="core" /></g>}

        <g class={hot && hot !== 'ulnar' ? 'lab dim' : 'lab'}><line x1="160" y1="70" x2="136" y2="70" /><text x="130" y="75" text-anchor="end" class="t">{t.ulnar}</text></g>
        <g class={hot && hot !== 'radial' ? 'lab dim' : 'lab'}><line x1="244" y1="120" x2="258" y2="120" /><text x="263" y="125" class="t">{t.radial}</text></g>
        <g class={hot && hot !== 'median' ? 'lab dim' : 'lab'}><line x1="202" y1="250" x2="258" y2="250" /><text x="263" y="255" class="t">{t.median}</text></g>
        {showSite('cubital') && <g class="lab hot"><line x1="141" y1="150" x2="136" y2="150" /><text x="130" y="148" text-anchor="end" class="t">{t.cubital}</text><text x="130" y="166" text-anchor="end" class="t">{t.cubital2}</text></g>}
        {showSite('carpal') && <g class="lab hot"><line x1="214" y1="362" x2="258" y2="340" /><text x="263" y="338" class="t">{t.carpal}</text><text x="263" y="356" class="t">{t.carpal2}</text></g>}
        {showSite('guyon') && <g class="lab hot"><line x1="171" y1="364" x2="136" y2="364" /><text x="130" y="362" text-anchor="end" class="t">{t.guyon}</text><text x="130" y="380" text-anchor="end" class="t">{t.guyon2}</text></g>}
      </svg>
    )}
    {limb === 'arm' && (
      <svg viewBox="0 110 400 380" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <clipPath id="nv-hand"><rect x="45" y="150" width="112" height="125" rx="24" /><rect x="62" y="250" width="80" height="90" />{handCaps.map((c) => <rect {...c} />)}</clipPath>
        </defs>
        {[{ tx: 14, flip: false, label: t.palm }, { tx: 386, flip: true, label: t.back }].map((h) => (
          <g transform={`translate(${h.tx} 96) ${h.flip ? 'scale(-1 1)' : ''}`}>
            <g class="skin-edge"><rect x="45" y="150" width="112" height="125" rx="24" /><rect x="62" y="250" width="80" height="90" />{handCaps.map((c) => <rect {...c} />)}</g>
            <g class="skin"><rect x="45" y="150" width="112" height="125" rx="24" /><rect x="62" y="250" width="80" height="90" />{handCaps.map((c) => <rect {...c} />)}</g>
            <g clip-path="url(#nv-hand)">
              {!h.flip && <polygon class={zcls('median')} points="0,0 121,0 117,264 0,264" />}
              {!h.flip && <polygon class={zcls('ulnar')} points="121,0 180,0 180,264 117,264" />}
              {h.flip && <polygon class={zcls('radial')} points="0,0 121,0 117,264 0,264" />}
              {h.flip && <polygon class={zcls('median')} points="38,0 122,0 121,88 106,88 106,72 77,72 77,92 38,92" />}
              {h.flip && <polygon class={zcls('ulnar', focus !== 'guyon')} points="121,0 180,0 180,264 117,264" />}
            </g>
            {!h.flip && <path class="crease" d="M66 262 Q100 270 138 262" />}
          </g>
        ))}
        <text x="110" y="470" text-anchor="middle" class="t">{t.palm}</text>
        <text x="290" y="470" text-anchor="middle" class="t">{t.back}</text>
      </svg>
    )}

    {limb === 'leg' && (
      <svg viewBox="0 0 400 480" role="img" aria-label={aria} xmlns="http://www.w3.org/2000/svg">
        <g transform="translate(34 14) scale(.84)">
          <path class="skin-edge" d={legPath} /><path class="skin" d={legPath} />
          <ellipse class="crease" cx="195" cy="264" rx="19" ry="23" />
          <path class="crease" d="M124 44 Q200 80 264 96" />
          <path class="nv nv-trunk back" d="M214 20 C210 110 204 180 196 232" />
          <path class={`${cls('tibial')} back`} d="M196 232 C204 300 210 380 214 430" />
          <path class={cls('tibial')} d="M214 430 C217 442 221 450 222 460 C222 478 214 500 204 516" />
          <path class={`${cls('peroneal')} back`} d="M196 232 C186 250 172 266 160 280" />
          <path class={cls('peroneal')} d="M160 280 C154 288 156 298 160 306 C168 350 182 410 192 456 L200 506 M160 306 C160 360 168 420 180 462 L178 502" />
          <path class={cls('lfcn')} d="M130 20 C132 34 135 44 139 56 C146 112 158 182 168 238 M148 120 C142 150 144 190 150 226" />
          {showSite('meralgia') && <g class="site"><circle cx="139" cy="52" r="15" class="glow" /><circle cx="139" cy="52" r="6" class="core" /></g>}
          {showSite('peroneal') && <g class="site"><circle cx="158" cy="292" r="15" class="glow" /><circle cx="158" cy="292" r="6" class="core" /></g>}
          {showSite('tarsal') && <g class="site"><circle cx="221" cy="456" r="15" class="glow" /><circle cx="221" cy="456" r="6" class="core" /></g>}
        </g>
        <g class={hot && hot !== 'lfcn' ? 'lab dim' : 'lab'}><line x1="160" y1="140" x2="118" y2="140" /><text x="112" y="138" text-anchor="end" class="t">{t.lfcn}</text><text x="112" y="156" text-anchor="end" class="t">{t.lfcn2}</text></g>
        <g class={hot ? 'lab dim' : 'lab'}><line x1="210" y1="110" x2="266" y2="110" /><text x="272" y="108" class="t">{t.sciatic}</text><text x="272" y="126" class="t">{t.nerve}</text></g>
        <g class={hot && hot !== 'peroneal' ? 'lab dim' : 'lab'}><line x1="176" y1="325" x2="118" y2="325" /><text x="112" y="323" text-anchor="end" class="t">{t.peroneal}</text><text x="112" y="341" text-anchor="end" class="t">{t.nerve}</text></g>
        <g class={hot && hot !== 'tibial' ? 'lab dim' : 'lab'}><line x1="209" y1="300" x2="256" y2="300" /><text x="262" y="298" class="t">{t.tibial}</text><text x="262" y="316" class="t">{t.nerve}</text></g>
        {showSite('meralgia') && <g class="lab hot"><line x1="138" y1="58" x2="118" y2="58" /><text x="112" y="56" text-anchor="end" class="t">{t.inguinal}</text><text x="112" y="74" text-anchor="end" class="t">{t.inguinal2}</text></g>}
        {showSite('peroneal') && <g class="lab hot"><line x1="154" y1="259" x2="118" y2="259" /><text x="112" y="257" text-anchor="end" class="t">{t.fibhead}</text><text x="112" y="275" text-anchor="end" class="t">{t.fibhead2}</text></g>}
        {showSite('tarsal') && <g class="lab hot"><line x1="233" y1="397" x2="256" y2="397" /><text x="262" y="395" class="t">{t.tarsal}</text><text x="262" y="413" class="t">{t.tarsal2}</text></g>}
      </svg>
    )}
    {limb === 'leg' && (
      <svg viewBox="0 0 400 480" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <clipPath id="nv-leg"><path d={legPath} /></clipPath>
          <clipPath id="nv-sole"><path d={solePath} />{toes.map(([x, y, r]) => <circle cx={x} cy={y} r={r} />)}</clipPath>
        </defs>
        <g transform="translate(-36 6) scale(.84)">
          <path class="skin-edge" d={legPath} /><path class="skin" d={legPath} />
          <g clip-path="url(#nv-leg)">
            <path class={zcls('lfcn')} d="M100 70 C120 60 150 80 158 130 C166 180 170 220 166 244 C150 250 140 240 132 220 C116 170 104 110 100 70 Z" />
            <path class={zcls('peroneal')} d="M140 296 L184 300 C188 360 194 420 199 452 L250 452 L250 540 L140 540 Z" />
          </g>
          <ellipse class="crease" cx="195" cy="264" rx="19" ry="23" />
        </g>
        <g transform="translate(-14 -70)">
          <g class="skin-edge"><path d={solePath} />{toes.map(([x, y, r]) => <circle cx={x} cy={y} r={r} />)}</g>
          <g class="skin"><path d={solePath} />{toes.map(([x, y, r]) => <circle cx={x} cy={y} r={r} />)}</g>
          <rect class={zcls('tibial')} x="280" y="300" width="100" height="220" clip-path="url(#nv-sole)" />
        </g>
        <text x="128" y="470" text-anchor="middle" class="t">{t.front}</text>
        <text x="318" y="470" text-anchor="middle" class="t">{t.sole}</text>
      </svg>
    )}
  </div>
  <ul class="nerve-legend">
    {legend.map(([k, name, text]) => (
      <li class={hot && hot !== k ? 'dim' : ''}><i class={`sw sw-${k}`}></i><span><strong>{name}</strong> {text}</span></li>
    ))}
  </ul>
  <figcaption>{limb === 'arm' ? (en ? 'Dashed line — the nerve runs at the back. ' : 'Пунктир — нерв идёт по задней поверхности. ') : (en ? 'Dashed line — the nerve runs at the back of the leg. ' : 'Пунктир — нерв идёт по задней поверхности ноги. ')}{caption}</figcaption>
</figure>
