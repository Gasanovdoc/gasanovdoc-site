---
import Base from '../../layouts/Base.astro';

const title = 'Анализы для госпитализации на операцию: список';
const description = 'Какие анализы и обследования сдать перед плановой нейрохирургической операцией, сколько они действительны и что взять с собой в больницу. Список можно скачать.';
const pdf = '/docs/pamyatka-gospitalizaciya.pdf';

const tests = [
  ['Общий анализ крови с лейкоцитарной формулой', '', '10 дней'],
  ['Общий анализ мочи', '', '10 дней'],
  ['Биохимический анализ крови', 'Общий белок, билирубин общий и прямой, креатинин, глюкоза, калий, натрий, АЛТ, АСТ, холестерин, ЛПВП, ЛПНП, ЛПОНП, коэффициент атерогенности', '10 дней'],
  ['Коагулограмма', 'ПТИ, МНО, АЧТВ, фибриноген, D-димер', '10 дней'],
  ['Анализ на сифилис', 'Микрореакция (кардиолипиновая проба)', '10 дней'],
  ['Анализ крови на ВИЧ', '', '6 месяцев'],
  ['Анализ крови на гепатиты B и C', '', '6 месяцев'],
  ['КТ или рентгенография лёгких', '', '6 месяцев'],
  ['ЭКГ', 'Плёнка и заключение', '1 месяц'],
  ['УЗИ вен нижних конечностей', '', '1 месяц'],
  ['УЗИ сердца (ЭхоКГ)', '', '2 месяца'],
  ['Группа крови и резус-фактор', 'Фенотип и антитела', 'любой давности'],
];
const opinions = [
  ['Заключение терапевта', 'С указанием, что противопоказаний к операции нет'],
  ['Заключение кардиолога', 'С указанием, что противопоказаний к операции нет'],
];
const bring = [
  'Паспорт, полис ОМС, СНИЛС',
  'Результаты всех анализов и обследований из списка',
  'Все снимки МРТ и КТ, заключения к ним, диски',
  'Выписки из больниц, справки о перенесённых инфарктах и инсультах',
  'Компрессионные чулки для операции — 2 шт.',
  'Все лекарства, которые вы принимаете постоянно, — в том числе ингаляторы при бронхиальной астме и инсулин при сахарном диабете',
  'При сахарном диабете — глюкометр и тест-полоски',
];

const jsonld = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  name: title,
  description,
  inLanguage: 'ru',
  url: 'https://gasanovdoc.ru/pacientam/analizy-dlya-gospitalizacii/',
  author: { '@type': 'Physician', name: 'Тимур Гасанов' },
  audience: { '@type': 'Patient' },
});
---
<Base title={title} description={description} jsonld={jsonld}>
<main id="top">
  <header class="page-head">
    <div class="wrap">
      <div class="print-brand"><b>Тимур Гасанов, нейрохирург</b><span>gasanovdoc.ru · Telegram @gasanov_doc · 8 (963) 050-35-39</span></div>
      <ol class="crumbs">
        <li><a href="/">Главная</a></li>
        <li><a href="/pacientam/">Пациентам</a></li>
        <li aria-current="page">Анализы для госпитализации</li>
      </ol>
      <h1>Анализы и обследования для госпитализации</h1>
      <p class="lede">Список для плановой операции в нейрохирургическом отделении, где я оперирую. Срок годности считается на день госпитализации. В другой больнице требования могут отличаться — уточните их заранее.</p>
      <div class="toolbar">
        <a class="btn btn-fill" href={pdf} download>
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M10 3v10m0 0l-4-4m4 4l4-4M4 16h12"/></svg>
          Скачать PDF
        </a>
        <a class="btn btn-line" href={pdf} target="_blank" rel="noopener">Открыть PDF</a>
        <button class="btn btn-line" type="button" onclick="window.print()">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 8V3h10v5M5 14H3V8h14v6h-2M6 11h8v6H6z"/></svg>
          Распечатать
        </button>
      </div>
    </div>
  </header>

  <div class="wrap doc">
    <article class="body">
      <section id="analizy">
        <h2>Анализы и обследования</h2>
        <ul class="checklist">
          {tests.map(([name, note, term]) => (
            <li><span>{name}</span><em>{term}</em>{note && <small>{note}</small>}</li>
          ))}
        </ul>
        <h3>Заключения специалистов</h3>
        <ul class="checklist">
          {opinions.map(([name, note]) => (<li><span>{name}</span><small>{note}</small></li>))}
        </ul>
        <div class="callout">
          <p><strong>Результаты обследований остаются в больнице.</strong> Если они нужны вам самим, сделайте копии заранее.</p>
        </div>
      </section>

      <section id="vzyat">
        <h2>Что взять с собой</h2>
        <ul class="checklist">
          {bring.map((item) => (<li><span>{item}</span></li>))}
        </ul>
      </section>

      <section id="lekarstva">
        <h2>Лекарства, которые влияют на свёртываемость крови</h2>
        <p>Постоянную терапию — от давления, сахарного диабета, щитовидной железы и другие — перед госпитализацией не отменяйте и возьмите препараты с собой.</p>
        <p>Отдельно нужно решить вопрос с препаратами, которые разжижают кровь: они повышают риск кровотечения во время операции.</p>
        <ul>
          <li><strong>Антиагреганты и антикоагулянты</strong> (Кардиомагнил, ТромбоАСС, варфарин и другие) обычно отменяют за 5–7 дней до госпитализации — срок зависит от препарата. Варфарин, как правило, заменяют уколами антикоагулянтов под кожу; препарат и дозу подбирает ваш терапевт или кардиолог.</li>
          <li><strong>При некоторых операциях эти препараты не отменяют</strong> — например, при каротидной эндартерэктомии и стентировании сосудов.</li>
        </ul>
        <div class="callout alert">
          <p><strong>Не отменяйте эти препараты самостоятельно.</strong> Решение о том, отменять ли их, когда и чем заменить, принимает врач, который их назначил, по согласованию с оперирующим хирургом.</p>
        </div>
      </section>

      <aside class="cta-box">
        <h2>Остались вопросы о подготовке?</h2>
        <p class="lede">Напишите — подскажу, какие обследования нужны именно в вашей ситуации и как спланировать приезд, если вы из другого города.</p>
        <div class="btns">
          <a class="btn btn-fill" href="/#request">Оставить заявку</a>
          <a class="btn btn-line" href="https://t.me/gasanov_doc" target="_blank" rel="noopener">Написать в Telegram</a>
        </div>
      </aside>
    </article>

    <nav class="toc" aria-label="Содержание">
      <p>Содержание</p>
      <ol>
        <li><a href="#analizy">Анализы и обследования</a></li>
        <li><a href="#vzyat">Что взять с собой</a></li>
        <li><a href="#lekarstva">Лекарства и свёртываемость</a></li>
      </ol>
    </nav>
  </div>
</main>
</Base>
