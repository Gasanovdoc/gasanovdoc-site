---
import Base from '../../layouts/Base.astro';
import { directions } from '../../data/directions';

export function getStaticPaths() {
  return directions.map((d) => ({ params: { hub: d.slug }, props: { d } }));
}
const { d } = Astro.props;
const url = `https://gasanovdoc.ru/lechenie/${d.slug}/`;
const jsonld = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'MedicalWebPage', name: d.title, description: d.description, url, inLanguage: 'ru',
      author: { '@type': 'Physician', name: 'Тимур Гасанов' },
      about: d.conditions.map((c) => ({ '@type': 'MedicalCondition', name: c.name })) },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://gasanovdoc.ru/' },
      { '@type': 'ListItem', position: 2, name: 'Болезни и лечение', item: 'https://gasanovdoc.ru/lechenie/' },
      { '@type': 'ListItem', position: 3, name: d.title, item: url } ] },
  ],
});
---
<Base title={d.seoTitle} description={d.description} jsonld={jsonld}>
<main id="top">
  <header class="page-head">
    <div class="wrap">
      <ol class="crumbs">
        <li><a href="/">Главная</a></li>
        <li><a href="/lechenie/">Болезни и лечение</a></li>
        <li aria-current="page">{d.title}</li>
      </ol>
      <h1>{d.title}</h1>
      <p class="lede">{d.intro}</p>
    </div>
  </header>
  <div class="wrap hub">
    <h2 class="hub-h">Заболевания</h2>
    <div class="cards">
      {d.conditions.map((c) => c.href
        ? <a class="card" href={c.href}><h3>{c.name}</h3><p>{c.text}</p><span class="go">Читать статью</span></a>
        : <div class="card card-plain"><h3>{c.name}</h3><p>{c.text}</p></div>)}
    </div>
    <div class="hub-ops">
      <h2 class="hub-h">Операции</h2>
      <ul>{d.operations.map((o) => <li>{o}</li>)}</ul>
    </div>
    <aside class="cta-box">
      <h2>Разберу вашу ситуацию</h2>
      <p class="lede">Пришлите снимки МРТ или КТ и коротко опишите, что беспокоит. Отвечу, что видно на снимках и какие шаги разумны дальше.</p>
      <div class="btns">
        <a class="btn btn-fill" href="/#request">Оставить заявку</a>
        <a class="btn btn-line" href="https://t.me/gasanov_doc" target="_blank" rel="noopener">Написать в Telegram</a>
      </div>
    </aside>
  </div>
</main>
</Base>
