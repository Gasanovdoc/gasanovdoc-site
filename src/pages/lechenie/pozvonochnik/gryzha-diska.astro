---
import Base from '../../../layouts/Base.astro';

const title = 'Грыжа межпозвонкового диска: лечение и операция';
const description = 'Боль в пояснице или шее отдаёт в ногу или руку? Как подтверждают грыжу диска, когда помогает лечение и блокада, когда нужна операция и как восстанавливаться.';
const url = 'https://gasanovdoc.ru/lechenie/pozvonochnik/gryzha-diska/';
const tg = 'https://t.me/gasanovDOC';

const faq = [
  ['Нужно ли сразу делать МРТ при боли в спине?', 'Не всегда. Если нет тревожных признаков — нарастающей слабости, онемения в промежности, нарушений мочеиспускания, — можно начать с лечения и наблюдать 4–6 недель. Если за это время боль не уходит или появились новые симптомы, МРТ нужна.'],
  ['Можно ли удалить все грыжи сразу?', 'Нет, и это не нужно. Удаляют только ту грыжу, которая вызывает боль или неврологические нарушения. Остальные выпячивания, найденные на МРТ, наблюдают.'],
  ['Меня записали на операцию, а боль прошла. Что делать?', 'Обсудите это с врачом. Грыжа может уменьшиться сама, и если симптомы ушли, от операции часто можно отказаться.'],
  ['Нужна ли МРТ после операции?', 'После изолированного удаления грыжи при хорошем восстановлении контрольное МРТ обычно не требуется. При новых или вернувшихся симптомах вопрос об исследовании решает врач.'],
  ['Может ли грыжа появиться снова?', 'Может — на том же уровне или на соседнем. При возвращении боли по ноге или руке стоит обсудить её с врачом.'],
  ['Когда можно вернуться к спорту?', 'Начинайте с лечебной физкультуры как можно раньше, когда хирург разрешит движения после вашей операции. Первые упражнения лучше освоить с инструктором ЛФК или реабилитологом. К активным тренировкам переходят постепенно, в сроки, согласованные с хирургом.'],
  ['Можно ли летать на самолёте после операции?', 'Это зависит от вида операции и того, как долго вам можно сидеть. Если восстановление идёт без осложнений и вы уже можете сидеть в течение всей поездки, короткий перелёт, как правило, допустим. Перед длительным перелётом уточните у своего врача, когда можно лететь и какие меры предосторожности нужны.'],
];

const jsonld = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'MedicalWebPage', '@id': url, url, name: title, description, inLanguage: 'ru',
      author: { '@type': 'Physician', name: 'Тимур Гасанов', url: 'https://gasanovdoc.ru/' },
      about: {
        '@type': 'MedicalCondition', name: 'Грыжа межпозвонкового диска',
        alternateName: ['Грыжа диска', 'Межпозвоночная грыжа', 'Herniated disc'],
        associatedAnatomy: { '@type': 'AnatomicalStructure', name: 'Межпозвонковый диск' },
        possibleTreatment: [
          { '@type': 'MedicalProcedure', name: 'Микродискэктомия' },
          { '@type': 'MedicalProcedure', name: 'Радикулярная блокада' },
        ],
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://gasanovdoc.ru/' },
        { '@type': 'ListItem', position: 2, name: 'Болезни и лечение', item: 'https://gasanovdoc.ru/lechenie/' },
        { '@type': 'ListItem', position: 3, name: 'Позвоночник', item: 'https://gasanovdoc.ru/lechenie/pozvonochnik/' },
        { '@type': 'ListItem', position: 4, name: 'Грыжа межпозвонкового диска', item: url },
      ],
    },
    { '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
  ],
});
---
<Base title={title} description={description} jsonld={jsonld} ogType="article">
<main id="top">
  <header class="page-head">
    <div class="wrap">
      <ol class="crumbs">
        <li><a href="/">Главная</a></li>
        <li><a href="/lechenie/">Болезни и лечение</a></li>
        <li><a href="/lechenie/pozvonochnik/">Позвоночник</a></li>
        <li aria-current="page">Грыжа межпозвонкового диска</li>
      </ol>
      <h1>Грыжа межпозвонкового диска</h1>
      <p class="lede">Когда грыжа диска сдавливает нервный корешок, боль часто идёт полосой: от шеи по руке до кисти или от поясницы по ноге до стопы. Сама шея или спина при этом тоже может болеть.</p>
      <div class="byline">
        <span>Автор: <a href="/#about">Тимур Гасанов</a>, нейрохирург</span>
        <span>Обновлено: ноябрь 2026</span>
      </div>
      <div class="keyfacts" aria-label="Коротко">
        <div><b>Большинство</b><span>грыж лечатся без операции</span></div>
        <div><b>МРТ</b><span>основной метод диагностики</span></div>
        <div><b>30–60 мин</b><span>длится удаление грыжи</span></div>
        <div><b>Осмотр</b><span>проверяем силу мышц и чувствительность</span></div>
      </div>
    </div>
  </header>

  <div class="wrap doc">
    <article class="body">
      <section id="chto-eto">
        <h2>Что это такое</h2>
        <p>Между позвонками лежат диски — амортизаторы. Снаружи у диска прочная оболочка, <strong>фиброзное кольцо</strong>, внутри — плотное упругое <strong>ядро</strong>. Похоже на жёсткую прокладку с начинкой.</p>
        <p>Когда часть диска выпячивается за его обычные границы, рядом с выпячиванием может оказаться нервный корешок. Если корешок воспаляется или испытывает давление, боль ощущается по ходу руки или ноги. Иногда грыжу находят на МРТ случайно, когда никаких жалоб нет.</p>
        <ul>
          <li><strong>Протрузия</strong> — диск выбухает, но кольцо ещё цело. Это частая возрастная находка на МРТ, сама по себе она обычно не болит.</li>
          <li><strong>Грыжа (экструзия)</strong> — часть ядра вышла за пределы кольца.</li>
          <li><strong>Секвестр</strong> — фрагмент ядра оторвался и лежит отдельно. Звучит страшно, но именно секвестры нередко уменьшаются сами.</li>
        </ul>
        <div class="disc-figs">
          <figure>
            <a href="/media/disc-guide/L4-l5-disc-herniation.png">
              <img loading="lazy" src="/media/disc-guide/L4-l5-disc-herniation.png" width="423" height="538" alt="Боковой срез МРТ поясницы с грыжей диска L4–L5" />
            </a>
            <figcaption>На МРТ видно, как фрагмент диска L4–L5 выступает в позвоночный канал.</figcaption>
            <details class="figure-credit">
              <summary>Источник МРТ</summary>
              <a href="https://commons.wikimedia.org/wiki/File:L4-l5-disc-herniation.png">Edave, Wikimedia Commons</a> · <a href="https://creativecommons.org/licenses/by-sa/3.0/">CC BY-SA 3.0</a>
            </details>
          </figure>
          <figure>
            <a href="/media/disc-guide/disc-sagittal.svg">
              <img loading="lazy" src="/media/disc-guide/disc-sagittal.svg" width="1000" height="1111" alt="Боковой разрез поясницы с фрагментом диска у нервного корешка позади тел позвонков" />
            </a>
            <figcaption>Боковой разрез поясницы. Серо-голубое ядро окружено слоями фиброзного кольца. Стрелка показывает, где фрагмент диска выходит в позвоночный канал рядом с нервным корешком.</figcaption>
          </figure>
        </div>
      </section>

      <section id="simptomy">
        <h2>Симптомы</h2>
        <p>Каждый корешок связан с определённой областью кожи — дерматомом. Поэтому я прошу пациента показать пальцем, откуда начинается боль и до какого пальца руки или какой части стопы она доходит.</p>
        <ul><li><strong>В руке.</strong> При раздражении корешка C6 боль или покалывание могут пройти по наружному краю предплечья к большому пальцу. При поражении C7 ощущения чаще доходят до среднего пальца и иногда затрагивают указательный.</li>
        <li><strong>В ноге.</strong> При поражении L5 полоса боли может пройти по наружной поверхности голени к тылу стопы и большому пальцу. При поражении S1 боль чаще идёт по задней поверхности голени к наружному краю стопы.</li></ul>
        <p>На схеме цветной полосой отмечен примерный путь боли. Зоны соседних корешков перекрываются, поэтому ощущения не всегда точно повторяют рисунок.</p>
        <figure>
          <a href="/media/disc-guide/root-zones.svg">
            <img loading="lazy" src="/media/disc-guide/root-zones.svg" width="934" height="660" alt="Где могут ощущаться симптомы при раздражении корешков C6, C7, L5 и S1" />
          </a>
          <figcaption>На руке золотом выделена зона C6 до большого пальца. Бирюзовым показан вариант зоны C7, которая захватывает указательный и средний пальцы. На голени и стопе соседствуют зоны L5 и S1.</figcaption>
        </figure>
        <figure>
          <a href="/media/disc-guide/dermatome-map.svg">
            <img loading="lazy" src="/media/disc-guide/dermatome-map.svg" width="1080" height="1120" alt="Общая карта дерматомов человека спереди и сзади" />
          </a>
          <figcaption>Карта чувствительности кожи спереди и сзади. Нажмите на изображение, чтобы увеличить.</figcaption>
        </figure>
        <p>Корешки передают сигналы чувствительности и движения. Раздражение может вызвать прострел, жжение или ощущение «мурашек». При нарушении чувствительности немеет участок кожи. Когда страдают двигательные волокна, отдельная мышца слабеет — это называют <strong>парезом</strong>. Например, кисти становится трудно удерживать предметы или стопа начинает цепляться носком за пол.</p>
        <p>В составе нервов проходят и вегетативные волокна. Особенно важно вовремя распознать сдавление нескольких корешков внизу позвоночного канала. Если стало трудно помочиться или онемела промежность, нужна экстренная оценка. При новой или нарастающей слабости в руке или ноге также важно обратиться за помощью без промедления.</p>
      </section>

      <section id="diagnostika">
        <h2>Диагностика</h2>
        <ul>
          <li><strong>Осмотр невролога или нейрохирурга</strong> — главное. Я проверяю силу, чувствительность и рефлексы и понимаю, какой корешок страдает и связана ли боль с позвоночником.</li>
          <li><strong>МРТ позвоночника</strong> — основной метод. Показывает грыжу, давит ли она на нерв, и помогает исключить другие причины: опухоли, воспаление.</li>
          <li><strong>КТ</strong> — если МРТ сделать нельзя или нужно оценить кости.</li>
          <li><strong>Рентген</strong> грыжу не показывает, но с функциональными снимками в наклоне вперёд и назад помогает оценить нестабильность позвонков.</li>
          <li><strong>ЭНМГ</strong> — когда непонятно, грыжа это или, например, туннельный синдром.</li>
        </ul>
        <div class="callout">
          <p><strong>Заключение МРТ — ещё не приговор и не диагноз.</strong> Бывает, что в описании много пугающих терминов, а человек чувствует себя хорошо и операция ему не нужна. А бывает одна строчка — и сильная боль, при которой без хирургии не обойтись. Решение принимают по сочетанию жалоб, осмотра и самих снимков, а не только по тексту заключения.</p>
        </div>
      </section>

      <section id="lechenie">
        <h2>Лечение без операции</h2>
        <p>Если нет слабости в руке или ноге, нарушений работы тазовых органов, а боль на фоне лечения уменьшается, начинаем с консервативного лечения:</p>
        <ul>
          <li><strong>Лекарства</strong> — противовоспалительные, обезболивающие, снимающие мышечный спазм и другие препараты. Конкретную схему назначает врач.</li>
          <li><strong>Физиотерапия и массаж</strong> — уменьшают спазм и улучшают кровообращение.</li>
          <li><strong>Лечебная гимнастика</strong> — укрепляет мышцы и разгружает позвоночник. Комплекс упражнений при боли в спине я показывал <a href={`${tg}/42`} target="_blank" rel="noopener">в Telegram-канале</a>, а о том, какой спорт допустим при грыже, — <a href={`${tg}/33`} target="_blank" rel="noopener">в отдельном посте</a>.</li>
          <li><strong>Прицельная блокада.</strong> При некоторых видах корешковой боли инъекция может временно облегчить симптомы. <a href="/lechenie/pozvonochnik/blokady-i-rcha/">Подробнее о видах блокад и о том, зачем их проводят под контролем рентгена или УЗИ</a>.</li>
        </ul>
        <p><strong>Может ли грыжа уменьшиться сама?</strong> В моей практике есть пациенты, у которых грыжа уменьшилась и боль прошла без операции. У одного из них боль отдавала в ногу. На первом МРТ отделившийся фрагмент диска L4–L5 сдавливал нервные корешки. Через три месяца фрагмент стал меньше, давление на корешки исчезло, и нога перестала болеть. Вот <a href={`${tg}/229`} target="_blank" rel="noopener">два МРТ с интервалом в три месяца в моём Telegram-канале</a>.</p>
        <p>Похожий случай был и с шейным отделом. У пациента с грыжей диска C6–C7 боль простреливала до пальцев руки, немели пальцы и слабела кисть. Через четыре месяца на контрольном МРТ отделившийся фрагмент диска рассосался. Боль, онемение и слабость прошли. <a href={`${tg}/241`}>Разбор случая с МРТ в моём Telegram-канале</a>.</p>
      </section>

      <section id="operaciya">
        <h2>Когда нужна операция</h2>
        <p>Операцию рассматриваю, если на МРТ видно, что грыжа сдавливает корешок или спинной мозг, и есть хотя бы одно из условий:</p>
        <ul>
          <li>боль по ноге или руке остаётся выраженной и мешает жить, несмотря на лечение; сроки зависят от симптомов и осмотра;</li>
          <li>появилась или нарастает слабость в ноге или руке;</li>
          <li>нарушилось мочеиспускание или стул, появилось онемение в промежности — это может быть <strong>синдром конского хвоста</strong>, при котором нужна экстренная помощь.</li>
        </ul>
        <p>Размер грыжи сам по себе не решает: не каждая большая грыжа требует операции, и не каждую маленькую удаётся вылечить консервативно.</p>

        <h3>Чем отличаются операции</h3>
        <ul>
          <li><strong>Удаление грыжи позвоночника</strong> освобождает корешок от фрагмента диска. Доступ может быть микрохирургическим или эндоскопическим.</li>
          <li><strong>Декомпрессия позвоночного канала</strong> расширяет пространство для нервных структур при стенозе.</li>
          <li><strong>Спондилодез</strong> помогает стабилизировать сегмент и создать условия для костного сращения. Показания и тип конструкции зависят от отдела позвоночника.</li>
        </ul>
        <p>Разбираю, как принимаю решение об операции, <a href={`${tg}/34`}>в посте о лечении грыжи</a>. Один из примеров — <a href={`${tg}/234`}>видео о небольшой поясничной грыже, которая вызвала сильную боль</a>.</p>
      </section>

      <section id="vosstanovlenie">
        <h2>Восстановление</h2>
        <p>План восстановления зависит от того, что именно сделали и как вы себя чувствуете. До выписки уточните, как ухаживать за раной, когда увеличивать нагрузку и в каких случаях нужен корсет. Он требуется по отдельным показаниям. Боль по ноге или руке может уменьшиться раньше, чем восстановятся сила и чувствительность. Полезно заранее согласовать сроки контрольного осмотра и возвращения к работе.</p>
        <p><a href="/pacientam/uhod-za-ranoy/">Памятка по уходу за раной</a> · <a href={`${tg}/41`}>Ответы на вопросы в моём Telegram</a></p>
      </section>

      <section id="voprosy" class="faq">
        <h2>Частые вопросы</h2>
        <div style="margin-top:18px">
          {faq.map(([q, a]) => (<details><summary>{q}</summary><p>{a}</p></details>))}
        </div>
      </section>

      <section id="iz-kanala">
        <h2>Из моего Telegram-канала</h2>
        <ul><li><a href={`${tg}/30`}>Как распознать симптомы грыжи</a></li><li><a href={`${tg}/31`}>Что показывает МРТ и зачем нужен осмотр</a></li><li><a href={`${tg}/229`}>Случай из практики: как поясничная грыжа уменьшилась за три месяца</a></li></ul>
      </section>

      <aside class="cta-box">
        <h2>Разберу ваши снимки</h2>
        <p class="lede">Пришлите МРТ позвоночника и коротко опишите, где и как давно болит. Отвечу, давит ли грыжа на нерв, какие варианты лечения подходят и есть ли показания к операции.</p>
        <div class="btns">
          <a class="btn btn-fill" href="/#request">Оставить заявку</a>
          <a class="btn btn-line" href="https://t.me/gasanov_doc" target="_blank" rel="noopener">Написать в Telegram</a>
          <a class="btn btn-line" href="https://clc.li/jmoBz" target="_blank" rel="noopener">Написать в MAX</a>
        </div>
      </aside>
    </article>

    <nav class="toc" aria-label="Содержание">
      <p>Содержание</p>
      <ol>
        <li><a href="#chto-eto">Что это такое</a></li>
        <li><a href="#simptomy">Симптомы</a></li>
        <li><a href="#diagnostika">Диагностика</a></li>
        <li><a href="#lechenie">Лечение без операции</a></li>
        <li><a href="#operaciya">Операция</a></li>
        <li><a href="#vosstanovlenie">Восстановление</a></li>
        <li><a href="#voprosy">Частые вопросы</a></li>
      </ol>
    </nav>
  </div>
</main>
</Base>
