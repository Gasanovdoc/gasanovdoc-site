---
import Base from '../../layouts/Base.astro';
const jsonld = `{"@context":"https://schema.org","@type":"Physician","name":"Timur Gasanov","medicalSpecialty":"Neurosurgery","description":"Neurosurgeon: brain, cerebrovascular, spine and peripheral nerve surgery","url":"https://gasanovdoc.ru/en/","areaServed":"Worldwide","availableLanguage":["ru","en"],"email":"gasanov.ns@yandex.ru","telephone":"+7-963-050-35-39","sameAs":["https://t.me/gasanovDOC","https://prodoctorov.ru/ekaterinburg/vrach/678776-gasanov/","https://www.instagram.com/gasanov_doc"]}`;
---
<Base lang="en" title="Neurosurgeon Timur Gasanov: brain and spine surgery" description="Neurosurgeon Timur Gasanov: brain tumours, aneurysms, AVMs, carotid stenosis, disc herniation, trigeminal neuralgia, nerve entrapment. MRI and CT review for patients from any country." jsonld={jsonld} ruPath="/" enPath="/en/">
<main id="top">
  <section class="hero">
    <figure class="hero-video">
      <video id="heroVideo" src="/media/hero.mp4" poster="/media/hero-poster.jpg" muted loop playsinline autoplay preload="metadata" aria-label="Timur Gasanov in the operating room"></video>
      <figcaption>In the operating room</figcaption>
    </figure>
    <div class="wrap">
      <div class="hero-text">
        <h1>Timur Gasanov</h1>
        <p class="role">Neurosurgeon. I operate on the brain — tumours and vascular disease — as well as the spine and peripheral nerves.</p>
        <p class="reach">I treat patients from Russia and from abroad</p>
        <div class="cta">
          <a class="btn btn-fill" href="#request">Send your scans</a>
          <a class="btn btn-line" href="#directions">Find your condition</a>
        </div>
      </div>
      <div class="record">
        <div><b>3500+</b><span>operations performed</span></div>
        <div><b>9 years</b><span>in neurosurgery</span></div>
        <div><b>Since 2020</b><span>among top-ranked neurosurgeons on ProDoctorov</span></div>
        <div><a href="https://prodoctorov.ru/ekaterinburg/vrach/678776-gasanov/" target="_blank" rel="noopener"><b>240+</b><span>patient reviews on ProDoctorov</span></a></div>
      </div>
    </div>
  </section>

  <section class="about" id="about">
    <div class="wrap">
      <figure class="about-photo"><img src="/media/portrait.webp" alt="Neurosurgeon Timur Gasanov" width="900" height="1350" loading="lazy"></figure>
      <div class="about-text">
        <h2>About me</h2>
        <p class="lede">I decided to become a neurosurgeon at the age of 12, and today I do the work I love. I operate on the brain, its blood vessels, the spine and peripheral nerves. My goal is for every patient to return to work, family and normal life after treatment.</p>
        <ul class="facts">
          <li><b>Practice</b>More than 3,500 operations: aneurysms and AVMs, brain tumours, carotid plaques, spine and nerves.</li>
          <li><b>Technology</b>Microsurgery, neuronavigation, endoscopy. Some tumours I remove through the nose, with no incision on the head.</li>
          <li><b>Training</b>Hands-on courses every year at leading centres, including the Burdenko National Medical Research Center of Neurosurgery and the Krylov School of Neurosurgery.</li>
          <li><b>Recognition</b><a href="https://prodoctorov.ru/ekaterinburg/vrach/678776-gasanov/" target="_blank" rel="noopener">Top-ranked on ProDoctorov</a> since 2020, nominee of the Governor’s “Technology of the Year” award, regional Ministry of Health diploma for a prevention blog.</li>
        </ul>
        <details class="edu">
          <summary>Courses and master classes</summary>
          <ul>
            <li><span>2025</span>Carotid endarterectomy, Krylov School of Fundamental Neurosurgery, Moscow</li>
            <li><span>2024</span>Reconstructive surgery of the brachiocephalic arteries, Burdenko National Medical Research Center of Neurosurgery, Moscow</li>
            <li><span>2024</span>Cerebral revascularization, Moscow</li>
            <li><span>2022</span>Cadaver course: skull base approaches and endoscopic transnasal surgery, Moscow</li>
            <li><span>2022</span>Intracranial endoscopic surgery: evacuation of intracerebral haematomas and hydrocephalus treatment, with Karl Storz, Moscow</li>
            <li><span>2021</span>Implantation of temporary and permanent spinal cord stimulators, Yekaterinburg</li>
            <li><span>2019</span>Spinal osteotomy and transpedicular fixation, Yekaterinburg</li>
            <li><span>2019</span>Surgical revascularization of the brain, Moscow</li>
          </ul>
        </details>
        <a class="more" href="#contacts">Contact me</a>
      </div>
    </div>
  </section>

  <section class="dir" id="directions">
    <div class="wrap">
      <div class="dir-intro">
        <h2>Conditions I treat</h2>
        <p class="lede">Each area covers the conditions I operate on: symptoms, diagnosis, surgery and recovery.</p>
      </div>
      <div class="tiles-dir">
        <a class="dtile" href="#"><span class="ill"><svg viewBox="0 0 200 130" aria-hidden="true"><path class="to" d="M72 40 C64 26 62 14 64 4" stroke-width="7"/><path class="ti" d="M72 40 C64 26 62 14 64 4" stroke-width="4.0"/><path class="ts" d="M72 40 C64 26 62 14 64 4" stroke-width="1.2" transform="translate(-1.2 -1.4)"/><path class="to" d="M148 56 C154 44 164 36 176 30" stroke-width="7"/><path class="ti" d="M148 56 C154 44 164 36 176 30" stroke-width="4.0"/><path class="ts" d="M148 56 C154 44 164 36 176 30" stroke-width="1.2" transform="translate(-1.2 -1.4)"/><path class="to" d="M60 104 C48 100 36 100 22 104" stroke-width="7"/><path class="ti" d="M60 104 C48 100 36 100 22 104" stroke-width="4.0"/><path class="ts" d="M60 104 C48 100 36 100 22 104" stroke-width="1.2" transform="translate(-1.2 -1.4)"/><path class="to" d="M98 76 C88 56 72 38 46 24" stroke-width="10"/><path class="ti" d="M98 76 C88 56 72 38 46 24" stroke-width="7.0"/><path class="ts" d="M98 76 C88 56 72 38 46 24" stroke-width="1.2" transform="translate(-1.2 -1.4)"/><path class="to" d="M98 76 C122 66 148 56 180 50" stroke-width="10"/><path class="ti" d="M98 76 C122 66 148 56 180 50" stroke-width="7.0"/><path class="ts" d="M98 76 C122 66 148 56 180 50" stroke-width="1.2" transform="translate(-1.2 -1.4)"/><path class="to" d="M44 128 C56 106 72 90 98 76" stroke-width="13"/><path class="ti" d="M44 128 C56 106 72 90 98 76" stroke-width="10.0"/><path class="ts" d="M44 128 C56 106 72 90 98 76" stroke-width="1.2" transform="translate(-1.2 -1.4)"/><path class="hf" d="M93 70 C84 62 82 48 90 40 C96 33 108 33 114 40 C120 47 118 58 110 64 C106 68 104 70 103 73 Z"/><path class="ts2" d="M94 46 C97 41 102 39 106 40"/></svg></span><h3>Cerebrovascular surgery</h3><p>Aneurysms, AVMs, cavernomas, moyamoya disease, carotid stenosis and plaques, trigeminal neuralgia</p></a>
        <a class="dtile" href="#"><span class="ill"><svg viewBox="0 0 200 145" aria-hidden="true"><path class="bonefill" d="M28 104 C20 60 46 12 100 8 C154 12 180 60 172 104 C171 116 166 126 158 132 L146 134 C136 128 124 126 116 130 L100 134 L84 130 C76 126 64 128 54 134 L42 132 C34 126 29 116 28 104 Z"/><path class="ln" d="M28 104 C20 60 46 12 100 8 C154 12 180 60 172 104 C171 116 166 126 158 132 L146 134 C136 128 124 126 116 130 L100 134 L84 130 C76 126 64 128 54 134 L42 132 C34 126 29 116 28 104 Z"/><path class="lt" d="M36 102 C29 62 52 20 100 16 C148 20 171 62 164 102 C162 110 158 118 152 122 C144 120 134 112 124 112 C116 112 110 118 104 116 L100 112 L96 116 C90 118 84 112 76 112 C66 112 56 120 48 122 C42 118 38 110 36 102 Z"/><path class="ln" d="M102 22 C142 26 162 62 158 100 C156 110 150 116 142 117 C136 112 128 108 120 108 C112 108 106 104 102 98 Z"/><path class="ln" d="M98 22 C58 26 38 62 42 100 C44 110 50 116 58 117 C64 112 72 108 80 108 C88 108 94 104 98 98 Z"/><path class="lt" d="M156 84 C146 84 138 86 130 90 M44 84 C54 84 62 86 70 90 M150 46 L141 51 M158 66 L148 68 M128 28 L124 37 M50 46 L59 51 M42 66 L52 68 M72 28 L76 37 M114 23 L112 32 M86 23 L88 32 M150 104 L141 101 M50 104 L59 101"/><path class="lt" d="M99 62 C93 56 86 58 85 64 C84 69 90 71 97 68 Z M101 62 C107 56 114 58 115 64 C116 69 110 71 103 68 Z"/><circle class="hf" cx="134" cy="52" r="11"/><circle class="hl" cx="134" cy="52" r="17" stroke-dasharray="2 4"/></svg></span><h3>Brain and nerve tumours</h3><p>Meningiomas, gliomas, pituitary adenomas, schwannomas, metastases</p></a>
        <a class="dtile" href="#"><span class="ill"><svg viewBox="0 0 200 130" aria-hidden="true"><rect class="ln" x="40" y="4" width="62" height="28" rx="7"/><rect class="ln" x="40" y="48" width="64" height="30" rx="7"/><rect class="ln" x="40" y="96" width="66" height="30" rx="7"/><path class="lt" d="M42 36 C60 40 84 40 102 36 M42 86 C60 90 86 90 104 86"/><path class="ln" d="M118 0 L118 130 M146 0 L146 130"/><path class="ln" d="M150 10 L176 18 L154 30 M152 56 L180 64 L156 76 M154 102 L182 110 L158 122"/><path class="hl" d="M132 0 C132 40 132 62 141 78 C146 90 140 106 132 130"/><path class="hf" d="M102 76 C116 73 134 77 140 86 C142 95 132 101 118 101 C110 101 104 99 102 95 Z"/></svg></span><h3>Spine</h3><p>Disc herniation and its removal, nerve blocks, radiofrequency ablation</p></a>
        <a class="dtile" href="#"><span class="ill"><svg viewBox="0 0 160 110" aria-hidden="true"><path class="ln" d="M64 108 L62 92 C56 86 46 76 40 66 C36 58 42 54 48 60 C52 64 56 68 60 70 L60 40 C60 34 68 34 68 40 L68 30 C68 23 77 23 77 30 L78 34 C78 28 87 28 87 34 L88 42 C88 36 96 36 96 42 L96 70 C96 82 92 88 88 92 L88 108"/><path class="lt" d="M64 96 L88 96"/><path class="hl" d="M76 108 L76 92 C76 82 72 74 66 66 M76 84 C76 74 74 60 72 44 M76 84 C78 72 80 58 82 46 M76 86 C80 76 86 64 90 54"/><path class="hl" d="M63 88 L89 88" stroke-width="3"/></svg></span><h3>Peripheral nerves</h3><p>Entrapment syndromes, nerve injuries and ruptures</p></a>
        <a class="dtile" href="#"><span class="ill"><svg viewBox="0 0 200 145" aria-hidden="true"><path class="bonefill" d="M28 104 C20 60 46 12 100 8 C154 12 180 60 172 104 C171 116 166 126 158 132 L146 134 C136 128 124 126 116 130 L100 134 L84 130 C76 126 64 128 54 134 L42 132 C34 126 29 116 28 104 Z"/><path class="ln" d="M28 104 C20 60 46 12 100 8 C154 12 180 60 172 104 C171 116 166 126 158 132 L146 134 C136 128 124 126 116 130 L100 134 L84 130 C76 126 64 128 54 134 L42 132 C34 126 29 116 28 104 Z"/><path class="lt" d="M36 102 C29 62 52 20 100 16 C148 20 171 62 164 102 C162 110 158 118 152 122 C144 120 134 112 124 112 C116 112 110 118 104 116 L100 112 L96 116 C90 118 84 112 76 112 C66 112 56 120 48 122 C42 118 38 110 36 102 Z"/><path class="plate" d="M100 8 C46 12 20 60 28 104 C29 116 34 126 42 132 L48 122 C42 118 38 110 36 102 C29 62 52 20 100 16 Z"/><circle class="dot" cx="92.0" cy="12.0" r="1.1"/><circle class="dot" cx="80.0" cy="13.5" r="1.1"/><circle class="dot" cx="68.0" cy="17.0" r="1.1"/><circle class="dot" cx="57.0" cy="23.0" r="1.1"/><circle class="dot" cx="48.0" cy="31.0" r="1.1"/><circle class="dot" cx="41.0" cy="41.0" r="1.1"/><circle class="dot" cx="36.0" cy="52.0" r="1.1"/><circle class="dot" cx="33.0" cy="64.0" r="1.1"/><circle class="dot" cx="32.0" cy="76.0" r="1.1"/><circle class="dot" cx="32.0" cy="88.0" r="1.1"/><circle class="dot" cx="32.0" cy="100.0" r="1.1"/><circle class="dot" cx="35.0" cy="112.0" r="1.1"/><circle class="dot" cx="39.0" cy="122.0" r="1.1"/><path class="ln" d="M102 22 C142 26 162 62 158 100 C156 110 150 116 142 117 C136 112 128 108 120 108 C112 108 106 104 102 98 Z"/><path class="ln" d="M98 22 C58 26 38 62 42 100 C44 110 50 116 58 117 C64 112 72 108 80 108 C88 108 94 104 98 98 Z"/><path class="lt" d="M156 84 C146 84 138 86 130 90 M44 84 C54 84 62 86 70 90 M150 46 L141 51 M158 66 L148 68 M128 28 L124 37 M50 46 L59 51 M42 66 L52 68 M72 28 L76 37 M114 23 L112 32 M86 23 L88 32 M150 104 L141 101 M50 104 L59 101"/><path class="hl" d="M99 56 C86 42 64 48 62 64 C60 78 80 84 97 76 Z"/><path class="hl" d="M101 56 C114 42 136 48 138 64 C140 78 120 84 103 76 Z"/><path class="hl" d="M132 72 C146 82 156 94 162 112" stroke-dasharray="3 3"/></svg></span><h3>Hydrocephalus and skull defects</h3><p>Shunt surgery, endoscopic third ventriculostomy, cranioplasty</p></a>
      </div>
    </div>
  </section>

  <section class="req" id="request">
    <div class="wrap">
      <div>
        <h2>I will review your case and scans</h2>
        <p class="lede">Send a request — I will look at your MRI or CT and reply. You can write from any country.</p>
        <ol class="steps">
          <li><b>Send a request</b>Your name, contacts and a link to your scans.</li>
          <li><b>I will get in touch</b>To clarify details and what else is needed.</li>
          <li><b>Receive a written opinion</b>What the scans show and what to do next.</li>
        </ol>
        <p class="note">An MRI report is not yet a diagnosis. A scan review does not replace an in-person examination.</p>
      </div>
      <form class="form" id="reqForm" novalidate>
        <h3>Request</h3>
        <p class="form-sub">I reply personally, usually within a few days. In Russian or English.</p>
        <div class="field"><label for="f-name">Your name</label><input id="f-name" name="name" autocomplete="given-name" required></div>
        <div class="row2">
          <div class="field"><label for="f-contact">Email, Telegram or WhatsApp</label><input id="f-contact" name="contact" placeholder="name@mail.com or @username" required></div>
          <div class="field"><label for="f-phone">Phone number</label><input id="f-phone" name="phone" type="tel" autocomplete="tel" placeholder="+"></div>
        </div>
        <div class="field"><label for="f-link">Link to your scans</label><input id="f-link" name="link" inputmode="url" placeholder="Google Drive, Dropbox, hospital cloud — if any"></div>
        <div class="field"><label for="f-text">What concerns you</label><textarea id="f-text" name="text" maxlength="1000" placeholder="Briefly: symptoms, for how long, which tests you have had"></textarea></div>
        <label class="consent"><input type="checkbox" id="f-ok" required><span>I consent to the processing of my personal data, including health information, in accordance with the <a href="#">privacy policy</a>.</span></label>
        <button class="btn btn-fill" type="submit">Send request</button>
        <p class="done" role="status">Preview only: the form is not connected yet.</p>
      </form>
    </div>
  </section>

  <section class="results" id="results">
    <div class="wrap">
      <div class="res-head">
        <div>
          <h2>Before and after</h2>
          <p class="lede">Cases from my practice. Patient data are hidden.</p>
        </div>
        <div class="res-nav">
          <button class="arrow" type="button" id="prev" aria-label="Previous case"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button>
          <span class="res-count" id="count" aria-live="polite">1 / 6</span>
          <button class="arrow" type="button" id="next" aria-label="Next case"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button>
        </div>
      </div>
      <div class="chips" role="group" aria-label="Choose a case">
          <button type="button" class="chip" aria-pressed="true" data-i="0">Cranioplasty</button>
          <button type="button" class="chip" aria-pressed="false" data-i="1">Meningioma</button>
          <button type="button" class="chip" aria-pressed="false" data-i="2">Carotid plaque</button>
          <button type="button" class="chip" aria-pressed="false" data-i="3">Carotid stenosis, 3D</button>
          <button type="button" class="chip" aria-pressed="false" data-i="4">Aneurysm</button>
          <button type="button" class="chip" aria-pressed="false" data-i="5">EC-IC bypass</button>
      </div>
      <div class="pair" id="pair">
        <figure class="shot before"><img id="ib" src="/media/cases/cranio-before.webp" alt="Skull defect: scan before surgery" width="900" height="900" loading="lazy"><span class="badge">Before</span><figcaption id="cb">Before cranioplasty</figcaption></figure>
        <figure class="shot after"><img id="ia" src="/media/cases/cranio-after.webp" alt="Skull defect: scan after surgery" width="900" height="900" loading="lazy"><span class="badge">After</span><figcaption id="ca">Titanium implant</figcaption></figure>
        <span class="mid" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
      </div>
      <div class="case-info">
        <h3 id="ct">Skull defect</h3>
        <p id="cd">Cranioplasty: a large defect closed with a custom titanium implant.</p>
        <a class="res-foot" href="https://t.me/gasanovDOC" target="_blank" rel="noopener">More cases on Telegram</a>
      </div>
    </div>
  </section>

  <section class="travel" id="travel">
    <div class="wrap">
      <div class="travel-head">
        <img src="/media/navigation.webp" alt="Timur Gasanov during endoscopic surgery, with navigation and endoscope images on the monitors" width="1400" height="1050" loading="lazy">
        <div class="travel-copy">
          <h2>Patients from other countries</h2>
          <p class="lede">We settle the key questions before you travel, so you arrive with a treatment plan. Surgery for international patients is available on a paid basis; details are discussed in private messages.</p>
        </div>
      </div>
      <ol class="journey">
        <li><span class="ic"><svg viewBox="0 0 24 24"><rect x="4" y="3" width="16" height="18" rx="2"/><circle cx="12" cy="11" r="4"/><path d="M8 18h8"/></svg></span><h3>Scan review</h3><p>You send your MRI or CT and I assess whether surgery is needed.</p></li>
        <li><span class="ic"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg></span><h3>Plan and dates</h3><p>I advise which tests to do and when to come.</p></li>
        <li><span class="ic"><svg viewBox="0 0 24 24"><path d="M2 16l20-6-3-3-7 2-5-4-2 1 3 5-4 1-2-2-1 1z"/><path d="M3 21h18"/></svg></span><h3>Visit and surgery</h3><p>Examination, surgery and recovery advice for when you return home.</p></li>
      </ol>
    </div>
  </section>

  <section class="contacts" id="contacts">
    <div class="wrap">
      <div>
        <h2>Contact me</h2>
        <p class="lede">Telegram is the fastest way to reach me; I reply in Russian and English. Case reviews and surgery videos (in Russian) are on my channel <a href="https://t.me/gasanovDOC">t.me/gasanovDOC</a>.</p>
        <p class="fn">*Instagram is owned by Meta, which is designated an extremist organisation and banned in the Russian Federation.</p>
      </div>
      <div class="tiles">
        <a class="tile" href="https://t.me/gasanov_doc"><span class="ic"><svg viewBox="0 0 24 24"><path d="M21 4L3 11l6 2 2 6 3-4 5 4 2-15z"/><path d="M9 13l9-7"/></svg></span><span><small>Telegram</small><b>@gasanov_doc</b></span></a>
        <a class="tile" href="https://clc.li/jmoBz"><span class="ic"><svg viewBox="0 0 24 24"><path d="M4 5h16v11H9l-5 4z"/></svg></span><span><small>MAX</small><b>clc.li/jmoBz</b></span></a>
        <a class="tile" href="tel:+79630503539"><span class="ic"><svg viewBox="0 0 24 24"><path d="M5 3h4l2 5-3 2a12 12 0 006 6l2-3 5 2v4a2 2 0 01-2 2A17 17 0 013 5a2 2 0 012-2z"/></svg></span><span><small>Phone</small><b>+7 963 050-35-39</b></span></a>
        <a class="tile" href="https://www.instagram.com/gasanov_doc" target="_blank" rel="noopener"><span class="ic"><svg viewBox="0 0 24 24"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r=".6"/></svg></span><span><small>Instagram*</small><b>@gasanov_doc</b></span></a>
        <a class="tile" href="https://t.me/gasanovDOC"><span class="ic"><svg viewBox="0 0 24 24"><path d="M4 9v6h3l5 4V5L7 9z"/><path d="M16 9a4 4 0 010 6"/></svg></span><span><small>Telegram channel</small><b>t.me/gasanovDOC</b></span></a>
        <a class="tile" href="mailto:gasanov.ns@yandex.ru"><span class="ic"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg></span><span><small>Email</small><b>gasanov.ns@yandex.ru</b></span></a>
      </div>
    </div>
  </section>
</main>
