      <div class="pair2">
        <div><img src="/media/cases/aneurysm-before.webp" alt="3D CT angiography: brain artery aneurysm before surgery" loading="lazy" width="900" height="900"><span>Before</span></div>
        <div><img src="/media/cases/aneurysm-after.webp" alt="3D CT angiography after aneurysm clipping" loading="lazy" width="900" height="900"><span>After</span></div>
