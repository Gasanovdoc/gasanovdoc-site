---
import '../styles/global.css';
import '../styles/pages.css';
interface Props { title: string; description: string; jsonld?: string; lang?: string; ogType?: string }
const { title, description, jsonld, lang = 'ru', ogType = 'website' } = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <meta property="og:type" content={ogType}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={new URL('/media/portrait.webp', Astro.site)}>
  <meta property="og:locale" content="ru_RU">
  <meta name="theme-color" content="#0f0e0c">
  <script is:inline>(function(){var d=document.documentElement;d.classList.add('js');try{var t=localStorage.getItem('theme');if(t)d.dataset.theme=t;}catch(e){}})()</script>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  {jsonld && <script type="application/ld+json" set:html={jsonld} />}
</head>
<body>
<header class="top">
  <div class="wrap">
    <a class="mark" href="/">Тимур Гасанов<small>нейрохирург</small></a>
    <nav class="menu" aria-label="Разделы сайта">
      <a href="/#directions">Болезни и лечение</a>
      <a href="/pacientam/" aria-current={path.startsWith('/pacientam/') ? 'page' : undefined}>Пациентам</a>
      <a href="/#results">Результаты</a>
      <a href="/#about">Обо мне</a>
    </nav>
    <div class="lang" aria-label="Язык"><a href={path} aria-current="true">RU</a><a href="/en/" lang="en">EN</a></div>
    <button class="theme-btn" type="button" aria-label="Светлая или тёмная тема" title="Светлая / тёмная тема" onclick="(function(d){var t=d.dataset.theme==='light'?'dark':'light';d.dataset.theme=t;try{localStorage.setItem('theme',t)}catch(e){}})(document.documentElement)">
      <svg class="moon" viewBox="0 0 20 20" aria-hidden="true"><path d="M16 12.5A7 7 0 0 1 7.5 4a6.5 6.5 0 1 0 8.5 8.5z"/></svg>
      <svg class="sun" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="3.6"/><path d="M10 1.8v2M10 16.2v2M1.8 10h2M16.2 10h2M4.2 4.2l1.4 1.4M14.4 14.4l1.4 1.4M4.2 15.8l1.4-1.4M14.4 5.6l1.4-1.4"/></svg>
    </button>
    <a class="btn btn-fill" href="/#request">Записаться</a>
  </div>
</header>
<slot />
<footer>
  <div class="wrap">
    <p class="warn">Имеются противопоказания. Необходима консультация специалиста.</p>
    <p><a href="#">Политика конфиденциальности</a>&nbsp;&nbsp;&nbsp;<a href="#">Согласие на обработку данных</a></p>
  </div>
</footer>
</body>
</html>
