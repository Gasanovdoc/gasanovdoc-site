---
import '../styles/global.css';
import '../styles/pages.css';
import { site } from '../data/site';
import { directions } from '../data/directions';
interface Props { title: string; description: string; jsonld?: string; lang?: 'ru' | 'en'; ogType?: string; ruPath?: string; enPath?: string }
const { title, description, jsonld, lang = 'ru', ogType = 'website' } = Astro.props;
const path = Astro.url.pathname;
const en = lang === 'en';
// pages that exist in both languages pass both paths; others fall back to the home page of the other language
const ruPath = Astro.props.ruPath ?? (en ? '/' : path);
const enPath = Astro.props.enPath ?? (en ? path : '/en/');
const hasPair = !!(Astro.props.ruPath && Astro.props.enPath);
const home = en ? '/en/' : '/';
const t = en
  ? { name: 'Timur Gasanov', role: 'neurosurgeon', nav: 'Site sections', dir: 'Conditions & treatment', res: 'Results', about: 'About me', contacts: 'Contact', lang: 'Language', theme: 'Light or dark theme', cta: 'Send scans', warn: 'Contraindications apply. A specialist consultation is required.', privacy: 'Privacy policy', consent: 'Consent to data processing', locale: 'en_US' }
  : { name: 'Тимур Гасанов', role: 'нейрохирург', nav: 'Разделы сайта', dir: 'Болезни и лечение', res: 'Результаты', about: 'Обо мне', contacts: '', lang: 'Язык', theme: 'Светлая или тёмная тема', cta: 'Записаться', warn: 'Имеются противопоказания. Необходима консультация специалиста.', privacy: 'Политика конфиденциальности', consent: 'Согласие на обработку данных', locale: 'ru_RU' };
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <meta property="og:type" content={ogType}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={new URL('/media/portrait.webp', Astro.site)}>
  <meta property="og:locale" content={t.locale}>
  {hasPair && <link rel="alternate" hreflang="ru" href={new URL(ruPath, Astro.site)} />}
  {hasPair && <link rel="alternate" hreflang="en" href={new URL(enPath, Astro.site)} />}
  {hasPair && <link rel="alternate" hreflang="x-default" href={new URL(ruPath, Astro.site)} />}
  <meta name="theme-color" content="#0f0e0c">
  <script is:inline>(function(){var d=document.documentElement;d.classList.add('js');try{var t=localStorage.getItem('theme');if(t)d.dataset.theme=t;}catch(e){}})()</script>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  {site.yandexVerification && <meta name="yandex-verification" content={site.yandexVerification} />}
  {site.googleVerification && <meta name="google-site-verification" content={site.googleVerification} />}
  {jsonld && <script type="application/ld+json" set:html={jsonld} />}
</head>
<body>
<header class="top">
  <div class="wrap">
    <a class="mark" href={home}>{t.name}<small>{t.role}</small></a>
    <nav class="menu" aria-label={t.nav}>
      <a href={en ? '/en/#directions' : '/lechenie/'} aria-current={path.startsWith('/lechenie/') ? 'page' : undefined}>{t.dir}</a>
      {!en && <a href="/pacientam/" aria-current={path.startsWith('/pacientam/') ? 'page' : undefined}>Пациентам</a>}
      <a href={home + '#results'}>{t.res}</a>
      <a href={en ? '/en/#about' : '/obo-mne/'} aria-current={path.startsWith('/obo-mne/') ? 'page' : undefined}>{t.about}</a>
      {en && <a href="/en/#contacts">{t.contacts}</a>}
    </nav>
    <div class="lang" aria-label={t.lang}><a href={ruPath} lang="ru" aria-current={en ? undefined : "true"}>RU</a><a href={enPath} lang="en" aria-current={en ? "true" : undefined}>EN</a></div>
    <button class="theme-btn" type="button" aria-label={t.theme} title={t.theme} onclick="(function(d){var t=d.dataset.theme==='light'?'dark':'light';d.dataset.theme=t;try{localStorage.setItem('theme',t)}catch(e){}})(document.documentElement)">
      <svg class="moon" viewBox="0 0 20 20" aria-hidden="true"><path d="M16 12.5A7 7 0 0 1 7.5 4a6.5 6.5 0 1 0 8.5 8.5z"/></svg>
      <svg class="sun" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="3.6"/><path d="M10 1.8v2M10 16.2v2M1.8 10h2M16.2 10h2M4.2 4.2l1.4 1.4M14.4 14.4l1.4 1.4M4.2 15.8l1.4-1.4M14.4 5.6l1.4-1.4"/></svg>
    </button>
    <a class="btn btn-fill" href={home + '#request'}>{t.cta}</a>
    <button class="burger" type="button" aria-label={en ? 'Menu' : 'Меню'} aria-expanded="false" aria-controls="mnav">
      <span></span><span></span><span></span>
    </button>
  </div>
  <nav class="mnav" id="mnav" aria-label={t.nav} hidden>
    <div class="wrap">
      {en ? (
        <ul class="mnav-main">
          <li><a href="/en/#directions">{t.dir}</a></li>
          <li><a href="/en/#request">Send your scans</a></li>
          <li><a href="/en/#results">{t.res}</a></li>
          <li><a href="/en/#about">{t.about}</a></li>
          <li><a href="/en/#contacts">{t.contacts}</a></li>
        </ul>
      ) : (
        <Fragment>
          <p class="mnav-h"><a href="/lechenie/">Болезни и лечение</a></p>
          <ul class="mnav-sub">
            {directions.map((d) => <li><a href={`/lechenie/${d.slug}/`} aria-current={path.startsWith(`/lechenie/${d.slug}/`) ? 'page' : undefined}>{d.title}</a></li>)}
          </ul>
          <ul class="mnav-main">
            <li><a href="/pacientam/">Пациентам</a></li>
            <li><a href="/#results">Результаты</a></li>
            <li><a href="/obo-mne/">Обо мне</a></li>
            <li><a href="/#contacts">Контакты</a></li>
          </ul>
        </Fragment>
      )}
      <div class="mnav-foot">
        <div class="lang"><a href={ruPath} lang="ru" aria-current={en ? undefined : "true"}>RU</a><a href={enPath} lang="en" aria-current={en ? "true" : undefined}>EN</a></div>
        <button class="theme-btn" type="button" aria-label={t.theme} onclick="(function(d){var t=d.dataset.theme==='light'?'dark':'light';d.dataset.theme=t;try{localStorage.setItem('theme',t)}catch(e){}})(document.documentElement)">
          <svg class="moon" viewBox="0 0 20 20" aria-hidden="true"><path d="M16 12.5A7 7 0 0 1 7.5 4a6.5 6.5 0 1 0 8.5 8.5z"/></svg>
          <svg class="sun" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="3.6"/><path d="M10 1.8v2M10 16.2v2M1.8 10h2M16.2 10h2M4.2 4.2l1.4 1.4M14.4 14.4l1.4 1.4M4.2 15.8l1.4-1.4M14.4 5.6l1.4-1.4"/></svg>
        </button>
      </div>
    </div>
  </nav>
</header>
<script is:inline>
(function(){
  var b=document.querySelector('.burger'),n=document.getElementById('mnav');
  function set(open){b.setAttribute('aria-expanded',open);n.hidden=!open;document.documentElement.classList.toggle('menu-open',open)}
  b.addEventListener('click',function(){set(n.hidden)});
  n.addEventListener('click',function(e){if(e.target.closest('a'))set(false)});
  document.addEventListener('keydown',function(e){if(e.key==='Escape')set(false)});
})();
</script>
<slot />
<footer>
  <div class="wrap">
    <p class="warn">{t.warn}</p>
    <p><a href="/politika-konfidencialnosti/">{t.privacy}</a>&nbsp;&nbsp;&nbsp;<a href="/soglasie-na-obrabotku-dannyh/">{t.consent}</a>&nbsp;&nbsp;&nbsp;<a href="/soglasie-cookie/">{en ? 'Cookies' : 'Файлы cookie'}</a>{site.yandexMetrikaId && <Fragment>&nbsp;&nbsp;&nbsp;<a href="#" onclick="window.cookieSettings&&window.cookieSettings();return false">{en ? 'Cookie settings' : 'Настройки cookie'}</a></Fragment>}</p>
  </div>
</footer>
{site.yandexMetrikaId && (
  <Fragment>
    <div class="cookie" id="cookie" role="dialog" aria-live="polite" aria-label={en ? 'Cookie consent' : 'Согласие на cookie'} hidden>
      <p>{en
        ? <Fragment>We use cookies and Yandex Metrica to understand how patients use the site. By clicking “Accept”, you consent to the processing of cookies under the <a href="/soglasie-cookie/">cookie consent</a> and the <a href="/politika-konfidencialnosti/">privacy policy</a> (in Russian).</Fragment>
        : <Fragment>Мы используем файлы cookie и Яндекс Метрику, чтобы понимать, как пациенты пользуются сайтом. Нажимая «Принять», вы даёте <a href="/soglasie-cookie/">согласие на обработку файлов cookie</a> в соответствии с <a href="/politika-konfidencialnosti/">политикой обработки персональных данных</a>.</Fragment>}
      </p>
      <div class="cookie-btns">
        <button type="button" class="btn btn-fill" id="cookieYes">{en ? 'Accept' : 'Принять'}</button>
        <button type="button" class="btn btn-line" id="cookieNo">{en ? 'Decline' : 'Отказаться'}</button>
      </div>
    </div>
    <script is:inline define:vars={{ id: Number(site.yandexMetrikaId) }}>
      (function(){
        var KEY='cookieConsent', VER='2026-10-25';
        function get(){try{var v=JSON.parse(localStorage.getItem(KEY)||'null');return v&&v.ver===VER?v.ok:null}catch(e){return null}}
        function put(ok){try{localStorage.setItem(KEY,JSON.stringify({ok:ok,ver:VER,at:new Date().toISOString()}))}catch(e){}}
        function metrika(){
          if(window.ym)return;
          (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};m[i].l=1*new Date();k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})(window,document,'script','https://mc.yandex.ru/metrika/tag.js','ym');
          ym(id,'init',{clickmap:true,trackLinks:true,accurateTrackBounce:true});
        }
        var box=document.getElementById('cookie'), st=get();
        if(st===true)metrika(); else if(st===null)box.hidden=false;
        document.getElementById('cookieYes').onclick=function(){put(true);box.hidden=true;metrika()};
        document.getElementById('cookieNo').onclick=function(){put(false);box.hidden=true};
        window.cookieSettings=function(){try{localStorage.removeItem(KEY)}catch(e){};location.reload()};
      })();
    </script>
  </Fragment>
)}
<script is:inline>
(function(){
  // защита изображений и видео: без контекстного меню, перетаскивания и долгого нажатия
  document.addEventListener('contextmenu',function(e){if(e.target.closest('img,video,picture,figure,.ill'))e.preventDefault()});
  document.addEventListener('dragstart',function(e){if(e.target.closest('img,video'))e.preventDefault()});
  // при копировании большого фрагмента текста добавляем ссылку на источник
  document.addEventListener('copy',function(e){
    var sel=String(document.getSelection()||'');
    if(sel.length<200||!e.clipboardData)return;
    var src=location.href.split('#')[0];
    e.clipboardData.setData('text/plain',sel+'\n\nИсточник: '+src+' — Тимур Гасанов, нейрохирург');
    e.preventDefault();
  });
})();
</script>
<script is:inline>try{if('scrollRestoration' in history)history.scrollRestoration='manual';if(!location.hash){window.scrollTo(0,0);if(window.parent!==window){document.body.scrollIntoView({block:'start'});addEventListener('load',function(){document.body.scrollIntoView({block:'start'})})}}}catch(e){}</script>
</body>
</html>
