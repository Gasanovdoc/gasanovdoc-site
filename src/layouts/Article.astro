---
// Shared layout for disease / operation articles. Body sections go into the default slot;
// each section needs an id that matches an entry in `toc`.
import Base from './Base.astro';
interface Props {
  title: string; description: string; path: string;
  h1: string; lede: string;
  hub: { name: string; href: string };
  condition: { name: string; alternateName?: string[]; procedures?: string[] };
  keyfacts: [string, string][];
  toc: [string, string][];
  faq: [string, string][];
  cta: { title: string; text: string };
  updated?: string;
}
const p = Astro.props;
const url = new URL(p.path, 'https://gasanovdoc.ru').href;
const jsonld = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'MedicalWebPage', '@id': url, url, name: p.title, description: p.description, inLanguage: 'ru', lastReviewed: '2026-10-23',
      author: { '@type': 'Physician', name: 'Тимур Гасанов', url: 'https://gasanovdoc.ru/' },
      about: { '@type': 'MedicalCondition', name: p.condition.name, alternateName: p.condition.alternateName,
        possibleTreatment: (p.condition.procedures ?? []).map((n) => ({ '@type': 'MedicalProcedure', name: n })) } },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://gasanovdoc.ru/' },
      { '@type': 'ListItem', position: 2, name: 'Болезни и лечение', item: 'https://gasanovdoc.ru/lechenie/' },
      { '@type': 'ListItem', position: 3, name: p.hub.name, item: new URL(p.hub.href, 'https://gasanovdoc.ru').href },
      { '@type': 'ListItem', position: 4, name: p.h1, item: url } ] },
    { '@type': 'FAQPage', mainEntity: p.faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
  ],
});
---
<Base title={p.title} description={p.description} jsonld={jsonld} ogType="article">
<main id="top">
  <header class="page-head">
    <div class="wrap">
      <ol class="crumbs">
        <li><a href="/">Главная</a></li>
        <li><a href="/lechenie/">Болезни и лечение</a></li>
        <li><a href={p.hub.href}>{p.hub.name}</a></li>
        <li aria-current="page">{p.h1}</li>
      </ol>
      <h1>{p.h1}</h1>
      <p class="lede">{p.lede}</p>
      <div class="byline">
        <span>Автор: <a href="/#about">Тимур Гасанов</a>, нейрохирург</span>
        <span>Обновлено: {p.updated ?? 'октябрь 2026'}</span>
      </div>
      <div class="keyfacts" aria-label="Коротко">
        {p.keyfacts.map(([b, s]) => <div><b>{b}</b><span>{s}</span></div>)}
      </div>
    </div>
  </header>
  <div class="wrap doc">
    <article class="body">
      <slot />
      <section id="voprosy" class="faq">
        <h2>Частые вопросы</h2>
        <div style="margin-top:18px">
          {p.faq.map(([q, a]) => (<details><summary>{q}</summary><p>{a}</p></details>))}
        </div>
      </section>
      <slot name="urgent" />
      <aside class="cta-box">
        <h2>{p.cta.title}</h2>
        <p class="lede">{p.cta.text}</p>
        <div class="btns">
          <a class="btn btn-fill" href="/#request">Оставить заявку</a>
          <a class="btn btn-line" href="https://t.me/gasanov_doc" target="_blank" rel="noopener">Написать в Telegram</a>
        </div>
      </aside>
    </article>
    <nav class="toc" aria-label="Содержание">
      <p>Содержание</p>
      <ol>{[...p.toc, ['voprosy', 'Частые вопросы'], ...(Astro.slots.has('urgent') ? [['srochno', 'Срочная помощь']] : [])].map(([id, name]) => <li><a href={`#${id}`}>{name}</a></li>)}</ol>
    </nav>
  </div>
</main>
</Base>
